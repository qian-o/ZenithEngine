<Page x:Class="ZenithEngine.Editor.Views.MainView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:dock="using:WinUI.Dock"
      xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
      xmlns:vm="using:ZenithEngine.Editor.ViewModels"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Page.DataContext>
        <vm:MainViewModel />
    </Page.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <MenuBar Grid.Row="0">
            <MenuBarItem Title="File">
                <MenuFlyoutItem Command="{Binding NewProjectCommand}"
                                Text="New" />
                <MenuFlyoutItem Command="{Binding OpenProjectCommand}"
                                Text="Open..." />
                <MenuFlyoutItem Command="{Binding SaveProjectCommand}"
                                Text="Save" />
                <MenuFlyoutItem Command="{Binding ExitCommand}"
                                Text="Exit" />
            </MenuBarItem>
        </MenuBar>

        <dock:DockManager x:Name="Manager"
                          Grid.Row="1"
                          Adapter="{Binding}"
                          Behavior="{Binding}">
            <dock:LayoutPanel>
                <dock:DocumentGroup>
                    <dock:Document Title="Welcome"
                                   CanClose="False"
                                   CanPin="False">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Text="Welcome to Zenith Engine Editor" />
                    </dock:Document>
                </dock:DocumentGroup>
            </dock:LayoutPanel>
        </dock:DockManager>
    </Grid>
</Page>
